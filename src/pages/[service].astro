---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import FAQ from '../components/FAQ.astro';
import Workflow from '../components/Workflow.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Pricing from '../components/Pricing.astro';
import Simulation from '../components/Simulation.astro';
import VideoExamples from '../components/VideoExamples.astro';
import { services, type Service } from '../data/services';
import { sharedFaq } from '../data/site';
export function getStaticPaths() { return services.map(service => ({ params: { service: service.slug }, props: { service } })); }
interface Props { service: Service }
const { service: s } = Astro.props;
---
<Layout title={s.title} description={s.description} serviceName={s.name}>
 <div class="wrap"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Semua paket</a><span aria-hidden="true">/</span><span aria-current="page">{s.name}</span></nav></div>
 <section class="service-hero wrap"><div><p class="eyebrow">{s.name}</p><h1>{s.headline}</h1><p class="hero-description">{s.intro}</p><a class="button" href="#paket">{s.cta} <span aria-hidden="true">↓</span></a><p class="hero-meta">{s.tiers[0].media ? 'Mulai Rp5 juta/bulan, termasuk Rp3 juta saldo ads.' : 'Mulai Rp3,5 juta/bulan · AI Content Creation termasuk.'}</p></div><figure><Photo name={s.image} alt={s.alt} eager /><figcaption>Foto ilustrasi · {s.category}</figcaption></figure></section>
 <nav class="service-nav wrap" aria-label="Jelajahi strategi"><a href="#contoh">Contoh pendekatan</a><a href="#paket">Paket & cakupan</a><a href="#faq">Pertanyaan umum</a><a href="#strategi-lain">Strategi lain ↗</a></nav>
 <section class="section wrap service-approach"><div><p class="eyebrow">Apakah ini untuk bisnis Anda?</p><h2>{s.fit}</h2></div><div><p class="lead">{s.approach}</p><p>{s.need}</p><p class="subtle">Dikelola remote. Foto dan video asli direkam tim Anda; sesi produksi di lokasi tidak termasuk.</p></div></section>
 <section class="section examples-home" id="contoh"><div class="wrap"><p class="eyebrow">Ilustrasi konsep · Bukan hasil klien</p><h2>Begini ceritanya<br /><em>bisa dimulai.</em></h2><div class="concept-grid">{s.examples.map(e=><article><p class="eyebrow">{e.niche}</p><h3>“{e.title}”</h3><p>{e.text}</p></article>)}</div></div></section>
 <VideoExamples />
 <Pricing service={s} />{s.tiers[0].media > 0 && <Simulation />}
 <Workflow /><FAQ items={[...s.faq, ...sharedFaq]} /><FinalCTA headline={s.final} />
 <section class="section wrap related" id="strategi-lain"><p class="eyebrow">Kebutuhan yang berbeda?</p><h2>Jelajahi strategi lainnya.</h2><div>{services.filter(other=>other.slug!==s.slug).map(other=><a href={`/${other.slug}/`}><span>{other.name}</span><span aria-hidden="true">↗</span></a>)}</div></section>
</Layout>
