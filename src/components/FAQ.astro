---
interface Props { items: string[][] }
const { items } = Astro.props;
---
<section class="section wrap faq-section" id="faq"><div><p class="eyebrow">Tanya jawab</p><h2>Pertanyaan<br />tentang paket.</h2><p>Cek cara kerja, yang termasuk, dan yang perlu disiapkan tim Anda.</p></div><div class="faq-list">{items.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>
