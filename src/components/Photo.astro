---
interface Props { name: string; alt: string; eager?: boolean; class?: string }
const { name, alt, eager = false, class: className } = Astro.props;
---
<picture class={className}>
  <source type="image/avif" srcset={`/images/${name}-640.avif 640w, /images/${name}-960.avif 960w, /images/${name}-1200.avif 1200w`} sizes="(max-width: 700px) calc(100vw - 40px), 50vw" />
  <source type="image/webp" srcset={`/images/${name}-640.webp 640w, /images/${name}-1200.webp 1200w`} sizes="(max-width: 700px) 100vw, 50vw" />
  <img src={`/images/${name}-1200.webp`} width="1200" height="1000" alt={alt} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" />
</picture>
