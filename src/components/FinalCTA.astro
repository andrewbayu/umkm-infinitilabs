---
import { site, whatsapp } from '../data/site';
interface Props { headline?: string }
const { headline = 'Pilih paket yang cocok untuk bisnis Anda.' } = Astro.props;
---
<section class="final-cta"><div class="wrap final-inner"><p class="eyebrow">Paket F&B & hospitality dari InfinitiLabs</p><h2>{headline}</h2><p>Ceritakan jenis bisnis, lokasi, dan produk yang ingin diprioritaskan. Kami bantu menilai paket yang sesuai dengan aset dan kebutuhan Anda.</p><a class="button light" href={whatsapp()} target="_blank" rel="noopener noreferrer">Konsultasikan Bisnis Anda <span aria-hidden="true">↗</span></a><a class="email-link" href={`mailto:${site.email}`}>Atau email ke {site.email}</a></div></section>
