---
import { site, whatsapp } from '../data/site';
interface Props { headline?: string }
const { headline = 'Pilih paket yang cocok untuk bisnis Anda.' } = Astro.props;
---
<section class="final-cta"><div class="wrap final-inner"><p class="eyebrow">Paket kuliner & penginapan dari InfinitiLabs</p><h2>{headline}</h2><p>Kirim jenis bisnis, lokasi, dan layanan yang Anda butuhkan. Kami bantu memilih paket sesuai kebutuhan dan anggaran Anda.</p><a class="button light" href={whatsapp()} target="_blank" rel="noopener noreferrer">Tanya Paket lewat WhatsApp <span aria-hidden="true">↗</span></a><a class="email-link" href={`mailto:${site.email}`}>Atau email ke {site.email}</a></div></section>
